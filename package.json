{
  "name": "kpss-coach",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @kpss-coach/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --exclude tests/integration/**",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:edge": "node scripts/run-edge-smoke.mjs",
    "test:phase04-http": "node scripts/run-phase04-http-smoke.mjs",
    "test:phase05-http": "node scripts/run-phase05-http-smoke.mjs",
    "test:phase06-http": "node scripts/run-phase06-http-smoke.mjs",
    "test:phase07-http": "node scripts/run-phase07-http-smoke.mjs",
    "test:v1-e2e": "node scripts/run-v1-e2e.mjs",
    "test:telegram": "node scripts/run-telegram-smoke.mjs",
    "edge:bundle": "esbuild packages/domain/src/planning/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=supabase/functions/_shared/planning.bundle.js",
    "supabase:init": "node scripts/run-supabase.mjs init",
    "supabase:start": "node scripts/run-supabase.mjs start && node scripts/sync-supabase-env.mjs",
    "supabase:stop": "node scripts/run-supabase.mjs stop",
    "supabase:status": "node scripts/run-supabase.mjs status",
    "supabase:reset": "node scripts/run-supabase.mjs db reset",
    "supabase:functions:serve": "pnpm edge:bundle && node scripts/run-supabase.mjs functions serve",
    "test:weekly-pilot": "node scripts/run-weekly-pilot-smoke.mjs",
    "test:p48-roadmap": "node scripts/run-p48-roadmap-smoke.mjs",
    "edge:bundle:v2": "esbuild packages/domain/src/planning-v2/edge.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=supabase/functions/_shared/planning-v2.bundle.js",
    "edge:bundle:ai-coach": "esbuild packages/domain/src/ai-coach/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=supabase/functions/_shared/ai-coach.bundle.js",
    "test:ai-coach-safety": "node scripts/check-ai-coach-safety.mjs",
    "test:ai-coach-plan-preview-safety": "node scripts/check-ai-coach-plan-preview-safety.mjs",
    "test:planning-v2-shadow": "node scripts/run-planning-v2-shadow-smoke.mjs",
    "test:planning-v2-shadow-safety": "node scripts/check-planning-v2-shadow-safety.mjs"
  },
  "devDependencies": {
    "@kpss-coach/domain": "workspace:*",
    "@supabase/supabase-js": "^2.57.0",
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.1",
    "supabase": "2.39.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
