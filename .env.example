# `pnpm supabase:start` writes these public local values to apps/web/.env.local.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-the-local-anon-or-publishable-key

# Edge-only OpenAI secret; never expose this as a VITE_ variable.
OPENAI_API_KEY=

# Edge-only Telegram secrets; never expose these as VITE_ variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Edge-only scheduler secret used by cron/manual worker invocation.
SCHEDULER_WORKER_SECRET=
